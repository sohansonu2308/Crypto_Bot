# Reused existing GitHub Actions Telegram secrets
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Comma-separated public Telegram channel usernames (leading @ is stripped automatically)
TELEGRAM_CHANNELS=channel_1,channel_2,channel_3,channel_4

# OpenAI-compatible custom LLM endpoint configuration
LLM_BASE_URL=https://api.your-provider.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_FAST_MODEL=gpt-6-mini
LLM_REASONING_MODEL=gpt-6

# Optional custom headers as a JSON object (e.g. {"HTTP-Referer": "https://example.com"})
# LLM_EXTRA_HEADERS_JSON={}
